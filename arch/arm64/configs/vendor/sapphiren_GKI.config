CONFIG_LAST_LOG_MINIDUMP=y
CONFIG_SPI_SPIDEV=m
# CONFIG_BLK_DEV_BSG is not set
CONFIG_CMDLINE="cgroup_disable=pressure"
CONFIG_CMDLINE_EXTEND=y
CONFIG_IPC_LOG_MINIDUMP_BUFFERS=0
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_GPIO=m
CONFIG_MFD_QCOM_RPM=m
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE=m
CONFIG_POWER_RESET_QCOM_DOWNLOAD_MODE_DEFAULT=y
CONFIG_QCOM_AOSS_QMP=m
CONFIG_QCOM_CLK_RPM=m
CONFIG_QCOM_MINIDUMP_LAST_KMSG=y
CONFIG_QCOM_WATCHDOG_BARK_TIME=15000
# CONFIG_REGULATOR_QCOM_RPM is not set
CONFIG_SPMI_QTI_GLINK_DEBUG=m
CONFIG_USB_POWER_DELIVERY=y
CONFIG_FRAME_WARN=4096
CONFIG_QCOM_PMIC_VOTER=m
CONFIG_INPUT_FINGERPRINT=y
CONFIG_ANT_CHECK=m
CONFIG_ANT_CHECK_DIV=m
CONFIG_MI_THERMAL_INTERFACE=m
# CONFIG_ARCH_SCUBA is not set
# CONFIG_LEDS_QPNP_FLASH_V2 is not set
CONFIG_ZRAM_WRITEBACK=y
# CONFIG_QPNP_SMBLITE is not set

# DTBO
CONFIG_SAPPHIREN_DTB=y
